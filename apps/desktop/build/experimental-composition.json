  "experimentalEngineHead": "643343c3cd671d8f2b7c2841b45653d1f431d661",
  "identity": {
    "appId": "com.nousresearch.hermes",
    "executableName": "Hermes",
    "protocol": "hermes"
  },
  "runtimeIsolation": {
    "hermesHome": "%LOCALAPPDATA%\\hermes",
    "userData": "%APPDATA%\\Hermes",
    "stableProfileShared": true,
    "strategy": "versioned-candidate-runtime",
    "candidateId": "d12e12-643343c3-<build-commit>",
    "failClosedOnHashMismatch": true
  },
  "advisor": {
    "defaultEnabled": false,
    "provider": "openai-codex",
    "model": "gpt-5.6-sol",
    "credentialPolicy": "subscription_oauth_only",
    "fallback": "none",
    "failureBehavior": "keep_main_answer_with_visible_status",
    "maxFinalRevisions": 1
  },
  "agentSurface": {
    "sessionStripPurpose": "select_persistent_agent",
    "managerRoute": "/agents/manage",
    "temporarySubagentRouteExposed": false,
    "upstreamSubagentBehaviorChanged": false
  },
  "sessionBinding": {
    "authority": "desktop-session-binding-registry",
    "backendIdentity": [
      "connectionId",
      "profile",
      "gatewayEpoch"
    ],
    "durableIdentity": "storedSessionId",
    "runtimeIdentity": "rendererRuntimeKey",
    "routeGeneration": "routeToken",
    "missingOwner": "fail-closed-before-dispatch",
    "staleEpoch": "fail-closed-before-dispatch",
    "ambientGatewayFallback": false,
    "livePluginRawSessionIdAllowed": false,
    "sameRawRuntimeAcrossBackends": "isolated"
  },
  "verified": {
    "status": "pending-d12-product-acceptance"
  }
}
