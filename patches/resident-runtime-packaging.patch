diff --git a/apps/desktop/electron/resident-runtime.test.ts b/apps/desktop/electron/resident-runtime.test.ts
new file mode 100644
index 000000000..b00ee21eb
--- /dev/null
+++ b/apps/desktop/electron/resident-runtime.test.ts
@@ -0,0 +1,54 @@
+import assert from 'node:assert/strict'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { findResidentPython, resolveResidentPayload, shouldUseResidentPayload } from './resident-runtime'
+
+const completeManifest = JSON.stringify({
+  schemaVersion: 2,
+  candidate: 'V33-dev.7',
+  engineCommit: '5fc308a70719a83cccdbba4c0e39c23f5a8239d5',
+  items: Object.fromEntries(['repo', 'uv', 'python', 'site-packages', 'node'].map(item => [item, { status: 'staged' }]))
+})
+
+test('complete schema-2 payload resolves and runs resident', () => {
+  const payload = resolveResidentPayload('C:\\resources', () => completeManifest)
+
+  assert.equal(payload?.candidate, 'V33-dev.7')
+  assert.deepEqual(
+    shouldUseResidentPayload({ payload, checkoutExists: false, checkoutManifest: null, markerSaysDesktop: false }),
+    { resident: true, reason: 'complete resident payload' }
+  )
+})
+
+test('incomplete payload fails closed and source-owned checkout wins', () => {
+  const incomplete = resolveResidentPayload('C:\\resources', () =>
+    JSON.stringify({ schemaVersion: 2, items: { repo: { status: 'staged' } } })
+  )
+
+  assert.equal(incomplete, null)
+
+  const payload = resolveResidentPayload('C:\\resources', () => completeManifest)
+  assert.equal(
+    shouldUseResidentPayload({
+      payload,
+      checkoutExists: true,
+      checkoutManifest: { installMode: 'source' },
+      markerSaysDesktop: true
+    }).resident,
+    false
+  )
+})
+
+test('resident Python discovery uses the target platform path rules', () => {
+  const root = 'C:\\resources\\agent-payload'
+  const expected = path.win32.join(root, 'python', 'cpython-3.11.15-windows-x86_64-none', 'python.exe')
+
+  const found = findResidentPython(root, 'win32', {
+    readdirSync: () => ['cpython-3.11-windows-x86_64-none', 'cpython-3.11.15-windows-x86_64-none'] as any,
+    existsSync: candidate => candidate === expected
+  })
+
+  assert.equal(found, expected)
+})
diff --git a/apps/desktop/electron/resident-runtime.ts b/apps/desktop/electron/resident-runtime.ts
new file mode 100644
index 000000000..c4a707284
--- /dev/null
+++ b/apps/desktop/electron/resident-runtime.ts
@@ -0,0 +1,101 @@
+import fs from 'node:fs'
+import path from 'node:path'
+
+export const RESIDENT_RUNTIME_ITEMS = ['repo', 'uv', 'python', 'site-packages', 'node'] as const
+
+export interface ResidentPayload {
+  dir: string
+  schemaVersion: number
+  engineCommit: string | null
+  candidate: string | null
+  items: Record<string, { status?: unknown }>
+}
+
+export function resolveResidentPayload(
+  resourcesPath: string | null | undefined,
+  readFile: (file: string) => string = file => fs.readFileSync(file, 'utf8')
+): ResidentPayload | null {
+  if (!resourcesPath) {
+    return null
+  }
+
+  const dir = path.join(resourcesPath, 'agent-payload')
+
+  try {
+    const parsed = JSON.parse(readFile(path.join(dir, 'manifest.json')))
+
+    if (!parsed || parsed.schemaVersion !== 2 || parsed.thin === true) {
+      return null
+    }
+
+    const items = parsed.items && typeof parsed.items === 'object' ? parsed.items : {}
+    const complete = RESIDENT_RUNTIME_ITEMS.every(item => items[item]?.status === 'staged')
+
+    if (!complete) {
+      return null
+    }
+
+    return {
+      dir,
+      schemaVersion: parsed.schemaVersion,
+      engineCommit: typeof parsed.engineCommit === 'string' ? parsed.engineCommit : null,
+      candidate: typeof parsed.candidate === 'string' ? parsed.candidate : null,
+      items
+    }
+  } catch {
+    return null
+  }
+}
+
+export function shouldUseResidentPayload(facts: {
+  payload: ResidentPayload | null
+  checkoutExists: boolean
+  checkoutManifest: { installMode?: unknown } | null
+  markerSaysDesktop: boolean
+}): { resident: boolean; reason: string } {
+  if (!facts.payload) {
+    return { resident: false, reason: 'no complete resident payload' }
+  }
+
+  if (facts.checkoutManifest?.installMode === 'source') {
+    return { resident: false, reason: 'source-managed checkout' }
+  }
+
+  if (facts.checkoutExists && !facts.checkoutManifest && !facts.markerSaysDesktop) {
+    return { resident: false, reason: 'CLI-owned legacy checkout' }
+  }
+
+  return { resident: true, reason: 'complete resident payload' }
+}
+
+export function findResidentPython(
+  payloadDir: string,
+  platform: NodeJS.Platform = process.platform,
+  fsImpl: Pick<typeof fs, 'readdirSync' | 'existsSync'> = fs
+): string | null {
+  const pathImpl = platform === 'win32' ? path.win32 : path.posix
+  const pythonRoot = pathImpl.join(payloadDir, 'python')
+
+  try {
+    const entries = fsImpl
+      .readdirSync(pythonRoot)
+      .filter(name => name.startsWith('cpython-'))
+      .sort()
+      .reverse()
+
+    for (const entry of entries) {
+      const candidate =
+        platform === 'win32'
+          ? pathImpl.join(pythonRoot, entry, 'python.exe')
+          : pathImpl.join(pythonRoot, entry, 'bin', 'python3')
+
+      if (fsImpl.existsSync(candidate)) {
+        return candidate
+      }
+    }
+  } catch {
+    return null
+  }
+
+  return null
+}
