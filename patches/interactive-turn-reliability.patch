+# Foreground Desktop/TUI work uses deterministic, per-turn budgets.  Classifying
+# with another model call would spend time and money before doing any useful
+# work, so the gateway uses only request structure plus the explicit /goal
+# state.  Simple questions stay short, ordinary prompts retain the previous
+# safe ceiling, and only clear multi-step/goal work receives the larger budget.
+# ``agent.max_turns`` and HERMES_TUI_MAX_TURNS remain upper ceilings, so a user
+# may tighten every tier but a stale legacy value such as 500 cannot make a
+# foreground turn unbounded.
+_INTERACTIVE_SIMPLE_MAX_TURNS = 4
+_INTERACTIVE_STANDARD_MAX_TURNS = 12
+_INTERACTIVE_EXTENDED_MAX_TURNS = 30
+
+_INTERACTIVE_COMPLEX_WORK_RE = re.compile(
+    r"(?:\b(?:fix|debug|implement|build|deploy|migrate|refactor|audit|review|"
+    r"research|investigate|patch|test)\b|"
+    r"\b(?:sửa|vá|triển khai|xây dựng|tạo|viết|kiểm thử|gỡ lỗi|điều tra|"
+    r"nghiên cứu|rà soát|đối chiếu|nâng cấp|cập nhật|di chuyển|khắc phục)\b|"
+    r"(?:toàn bộ|nhiều bước|làm cho xong|đừng dừng|không dừng|tiếp tục cho đến))",
+    re.IGNORECASE,
+)
+_INTERACTIVE_SIMPLE_OPEN_RE = re.compile(
+    r"^(?:chào|xin chào|alo|cảm ơn|ai\b|gì\b|khi nào\b|ở đâu\b|tại sao\b|"
+    r"vì sao\b|mấy\b|bao nhiêu\b|có phải\b|có\b|làm sao\b|thế nào\b|"
+    r"what\b|when\b|where\b|who\b|why\b|how\b|is\b|are\b|can\b|"
+    r"could\b|do\b|does\b|did\b|should\b|would\b)",
+    re.IGNORECASE,
+)
+_INTERACTIVE_SIMPLE_CLOSE_RE = re.compile(
+    r"(?:à|ạ|hả|nhỉ|không|chưa|sao)\s*[.!?…]*$",
+    re.IGNORECASE,
+)
+
