+def _cfg_interactive_max_turns(cfg: dict) -> int:
+    """Resolve the hard foreground ceiling without inheriting a huge job cap."""
+    configured = _cfg_max_turns(cfg, _INTERACTIVE_EXTENDED_MAX_TURNS)
+    return min(configured, _INTERACTIVE_EXTENDED_MAX_TURNS)
+
+
+def _is_simple_interactive_prompt(prompt: Any) -> bool:
+    """Return True only for high-confidence conversational/direct questions."""
+    if not isinstance(prompt, str):
+        return False
+    text = prompt.strip()
+    if not text or len(text) > 240 or text.count("\n") > 1:
+        return False
+    if "```" in text or "://" in text or _INTERACTIVE_COMPLEX_WORK_RE.search(text):
+        return False
+    try:
+        from agent.memory_provider import is_trivial_prompt
+
+        if is_trivial_prompt(text):
+            return True
+    except Exception:
+        pass
+    if "?" in text:
+        return True
+    return bool(
+        _INTERACTIVE_SIMPLE_OPEN_RE.search(text)
+        or _INTERACTIVE_SIMPLE_CLOSE_RE.search(text)
+    )
+
+
+def _is_extended_interactive_prompt(prompt: Any) -> bool:
+    if not isinstance(prompt, str):
+        return True
+    text = prompt.strip()
+    if len(text) > 600 or "```" in text or text.count("\n") >= 3:
+        return True
+    if len(re.findall(r"(?m)^\s*(?:[-*]|\d+[.)])\s+", text)) >= 2:
+        return True
+    return bool(_INTERACTIVE_COMPLEX_WORK_RE.search(text))
+
+
+def _interactive_turn_budget(
+    cfg: dict,
+    prompt: Any,
+    *,
+    image_count: int = 0,
+    goal_active: bool = False,
+    synthesized: bool = False,
+) -> int:
+    """Choose one bounded model-round budget without an auxiliary model call."""
+    hard_ceiling = _cfg_interactive_max_turns(cfg)
+    if goal_active or synthesized or image_count > 0 or _is_extended_interactive_prompt(prompt):
+        tier = _INTERACTIVE_EXTENDED_MAX_TURNS
+    elif _is_simple_interactive_prompt(prompt):
+        tier = _INTERACTIVE_SIMPLE_MAX_TURNS
+    else:
+        tier = _INTERACTIVE_STANDARD_MAX_TURNS
+    return min(hard_ceiling, tier)
+
+
+def _session_goal_is_active(session: dict) -> bool:
+    """Read the existing durable /goal state; never ask a model to classify."""
+    session_key = str(session.get("session_key") or "").strip()
+    if not session_key:
+        return False
+    try:
+        from hermes_cli.goals import GoalManager
+
+        return GoalManager(session_id=session_key).is_active()
+    except Exception:
+        logger.debug("interactive turn budget: goal-state lookup failed", exc_info=True)
+        return False
+
