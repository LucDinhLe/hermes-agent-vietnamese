+function createBackendTimeoutError(timeoutMs: number) {
+  const error = new Error(`Timed out connecting to Hermes backend after ${timeoutMs}ms`) as NodeJS.ErrnoException
+
+  // Node's request retry policy classifies transport failures by ``code``.
+  // A plain Error with only this message bypasses the ETIMEDOUT path: safe
+  // GETs are never retried and every caller sees a raw renderer rejection.
+  error.code = 'ETIMEDOUT'
+
+  return error
+}
